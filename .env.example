TELEGRAM_TOKEN=your_telegram_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
ASIC_USER=root
ASIC_PASS=root

# Optional shared overrides
# MINER_SCRIPTS_ENV_FILE=/absolute/path/to/.env
# VIABTC_REQUEST_TIMEOUT=15
# VIABTC_USER_AGENT=Mozilla/5.0

# ViaBTC cookies
# VIABTC_COOKIE=
# VIABTC_BTC_COOKIE=
# VIABTC_BCH_COOKIE=

# ASIC web session cookie for miner API auth
# MINER_SESSION_COOKIE=
# ASIC_MINER_SESSION_COOKIE=

# Optional script-specific state/image overrides
# VIABTC_BTC_EARNINGS_STATE_FILE=
# VIABTC_BCH_EARNINGS_STATE_FILE=
# VIABTC_BTC_BLOCK_STATE_FILE=
# VIABTC_BCH_BLOCK_STATE_FILE=
# VIABTC_PPS_STATE_FILE=
# VIABTC_BTC_X_STATE_FILE=
# VIABTC_BTC_X_IMAGE_PATH=

# X / Twitter posting for rare BTC blocks
# X_API_KEY=
# X_API_KEY_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_TOKEN_SECRET=
# X_ALLOWED_TIERS=speedrun,divine,divine_rainbow
# X_POST_HASHTAGS=#Bitcoin #BTC #Mining

# Optional shell-script overrides
# BEST_SHARE_STATE_FILE_1=
# BEST_SHARE_STATE_FILE_2=

# Optional Python best share monitor overrides
# BEST_SHARE_STATE_FILE=
# BEST_SHARE_IMAGE_PATH=
# BEST_SHARE_BG_DIR=
# BEST_SHARE_MINER_IP=192.168.1.205
# BEST_SHARE_MINER_NAME=S21
# BEST_SHARE_REQUEST_TIMEOUT=15
# BEST_SHARE_MINER_TIMEOUT=10
